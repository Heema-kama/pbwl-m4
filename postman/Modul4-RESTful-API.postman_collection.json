{
  "info": {
    "name": "Modul 4 - RESTful API dan Konsumsi API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      }
    },
    {
      "name": "Daftar Program Studi",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/program-studi",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "program-studi"
          ]
        }
      }
    },
    {
      "name": "Daftar Mata Kuliah",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mata-kuliah",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mata-kuliah"
          ]
        }
      }
    },
    {
      "name": "Tambah Mata Kuliah",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"program_studi_id\": 1,\n  \"kode_mk\": \"SI901\",\n  \"nama_mk\": \"Pemrograman API\",\n  \"sks\": 3,\n  \"semester\": 4,\n  \"status_aktif\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/mata-kuliah",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mata-kuliah"
          ]
        }
      }
    },
    {
      "name": "Detail Mata Kuliah (ubah ID)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mata-kuliah/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mata-kuliah",
            "1"
          ]
        }
      }
    },
    {
      "name": "Update Mata Kuliah (ubah ID)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama_mk\": \"Pemrograman API Lanjutan\",\n  \"sks\": 3,\n  \"semester\": 4,\n  \"program_studi_id\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/mata-kuliah/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mata-kuliah",
            "1"
          ]
        }
      }
    },
    {
      "name": "Hapus Mata Kuliah (ubah ID)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mata-kuliah/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mata-kuliah",
            "1"
          ]
        }
      }
    },
    {
      "name": "Profil (Bearer Token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "me"
          ]
        }
      }
    },
    {
      "name": "Logout (Bearer Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "logout"
          ]
        }
      }
    }
  ]
}